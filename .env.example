# Synthetic Beta configuration surface.
#
# This file records variable names, the handoff default where one exists, and nothing else.
# There is no credential here, and none of the AWS entries below are read by any code in this
# repository yet: the execution plane is not built. See docs/architecture.md and infra/README.md.
#
# The one variable the front end reads today lives beside the front end:
#   apps/web/.env.example -> VITE_AUTHORIZED_DOMAINS
#
# A VITE_ variable is compiled into the browser bundle. Never put a secret in one.

# Region and resource names.
# AWS_REGION=
# RUN_TABLE=
# ARTIFACT_BUCKET=
# BROWSER_TOOL_ID=
# BEDROCK_MODEL_ID=

# Budget and limit ceilings. These mirror GUARDRAILS in packages/contracts/src/model.ts.
# MAX_GLOBAL_SPEND_USD=250
# DEFAULT_RUN_CAP_USD=45
# DEFAULT_BATCH_SIZE=10
# MAX_BATCH_SIZE=20
# DEFAULT_SESSION_SECONDS=180
# MAX_SESSION_SECONDS=300

# Targets the platform is authorized to test. Exact hosts. A wildcard is never accepted.
# DEMO_ALLOWED_DOMAINS=
