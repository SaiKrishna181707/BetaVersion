# Synthetic Beta configuration surface.
#
# This file records variable names, the handoff default where one exists, and nothing else.
# There is no credential here. CDK supplies resource identifiers to the deployed Lambdas.
#
# Frontend configuration: apps/web/.env.example.
#
# A VITE_ variable is compiled into the browser bundle. Never put a secret in one.

# Region and resource names.
# AWS_REGION=
# RUN_TABLE=
# ARTIFACT_BUCKET=
# BROWSER_TOOL_ID=
# BEDROCK_MODEL_ID=

# Budget and limit ceilings. These mirror GUARDRAILS in packages/contracts/src/model.ts.
# MAX_GLOBAL_SPEND_USD=250
# DEFAULT_RUN_CAP_USD=45
# DEFAULT_BATCH_SIZE=10
# MAX_BATCH_SIZE=20
# DEFAULT_SESSION_SECONDS=180
# MAX_SESSION_SECONDS=300

# Targets the platform is authorized to test. Exact hosts. A wildcard is never accepted.
# DEMO_ALLOWED_DOMAINS=

# Active local / deployment configuration (read by existing code).
# BETAVERSION_AUTHORIZED_DOMAINS=localhost,127.0.0.1
# BETAVERSION_API_PORT=4180
# BETAVERSION_ARTIFACTS_ROOT=.artifacts
# BETAVERSION_ENV=dev
# BETAVERSION_NOVA_ACT_REQUIREMENT=nova-act==3.4.187.0
# BETAVERSION_NOVA_ACT_MODEL_ID=nova-act-latest
# BETAVERSION_AMPLIFY_BRANCH=feat/product-foundation
# BETAVERSION_AMPLIFY_REPOSITORY=
# BETAVERSION_AMPLIFY_OAUTH_TOKEN_SECRET_ARN=
# CDK_DEFAULT_REGION=

# Supplied by deployment; for the real AWS smoke command only.
# BETAVERSION_API_URL=
# BETAVERSION_DEMO_URL=
