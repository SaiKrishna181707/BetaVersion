# Synthetic Beta configuration surface.
#
# Never commit credentials. A VITE_ variable is compiled into the browser bundle,
# so it must never contain a secret.

# Real Nova Act + AgentCore Browser worker.
AWS_REGION=us-east-1
NOVA_ACT_WORKFLOW_NAME=synthetic-beta-browser-session
NOVA_ACT_MODEL_ID=nova-act-latest

# Planned control-plane resources. These are not required for the one-session L2 worker.
# RUN_TABLE=
# ARTIFACT_BUCKET=
# BROWSER_TOOL_ID=

# Budget and limit ceilings. These mirror GUARDRAILS in packages/contracts/src/model.ts.
# MAX_GLOBAL_SPEND_USD=80
# DEFAULT_RUN_CAP_USD=45
# DEFAULT_BATCH_SIZE=10
# MAX_BATCH_SIZE=20
# DEFAULT_SESSION_SECONDS=180
# MAX_SESSION_SECONDS=300

# Exact targets the platform is authorized to test. Wildcards are not accepted.
# DEMO_ALLOWED_DOMAINS=

# Frontend-only variable lives in apps/web/.env.example:
# VITE_AUTHORIZED_DOMAINS=
