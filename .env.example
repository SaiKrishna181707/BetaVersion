# Centopus deployment settings. Export with your shell; CDK does not load this file.
# Never commit credentials or secret values.
AWS_REGION=us-east-1
CENTOPUS_PREFIX=centopus
CENTOPUS_CONTROL_ACCOUNT=
CENTOPUS_AGENT_ACCOUNT=
AMPLIFY_ORIGIN=
CROSS_ACCOUNT_EXTERNAL_ID=
# Optional existing MAIN-SCHEMA data resources; imported without replacement.
STATE_TABLE=
ARTIFACT_BUCKET=
# Optional secret ARN (not its contents) and notification address.
GEMINI_SECRET_ARN=
ALARM_EMAIL=

# Runtime configuration normally supplied by CDK.
RUN_STATE_MACHINE_ARN=
AGENT_EXECUTION_ROLE_ARN=
NOVA_WORKER_FUNCTION_ARN=
AGENT_REGION=us-east-1
NOVA_ACT_WORKFLOW_NAME=
NOVA_ACT_MODEL_ID=nova-act-latest
AGENTCORE_BROWSER_IDENTIFIER=aws.browser.v1

# Source-controlled GUARDRAILS (not environment overrides):
# $80 cumulative estimate reservations; $45 default run allowance.
# Five concurrent workers; 100 users/run; 40 actions; 300 seconds/session.
