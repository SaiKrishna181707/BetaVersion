# Browser-visible configuration. Never put credentials or secrets in VITE_ variables.
# Exact hosts only. Local preview allowlist; production must independently verify ownership.
VITE_AUTHORIZED_DOMAINS=localhost,127.0.0.1

# Base URL of the BetaVersion control plane. `npm run dev:api` serves the local one on this port.
VITE_API_BASE_URL=http://127.0.0.1:4180
